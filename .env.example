# Keep all live switches off until you are ready to use external services.
CIMENERGY_ENABLE_LIVE_CALLS=false
CIMENERGY_ENABLE_DEEPGRAM=false
CIMENERGY_ENABLE_TEMPORAL=false
CIMENERGY_ENABLE_AZURE=false
CIMENERGY_ENABLE_TINYFISH=false
CIMENERGY_ENABLE_ELEVENLABS=false

# Public HTTPS URL for Twilio webhooks, for example an ngrok URL.
# Any one of these names works.
PUBLIC_BASE_URL=
SERVER_EXTERNAL_URL=
PUBLIC_HOSTNAME=

DEEPGRAM_API_KEY=
DEEPGRAM_PROJECT_ID=
DEEPGRAM_LISTEN_MODEL=flux-general-en
DEEPGRAM_SPEAK_MODEL=aura-2-hyperion-en
DEEPGRAM_TELEPHONY_SPEAK_MODEL=aura-2-hyperion-en
DEEPGRAM_AGENT_LLM_PROVIDER=google
DEEPGRAM_AGENT_LLM_MODEL=gemini-3.1-flash-lite
DEEPGRAM_AGENT_ENDPOINT=wss://agent.deepgram.com/v1/agent/converse
# Cursor MCP: .cursor/mcp.json registers `dg mcp` and https://api.dx.deepgram.com/kapa/mcp

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

TEMPORAL_API=
TEMPORAL_NAMESPACE=
TEMPORAL_ADDRESS=
TEMPORAL_ID=
TEMPORAL_TASK_QUEUE=cimenergy-recovery

AZURE_API_KEY=
AZURE_OPENAI_ENDPOINT=
# Or use a Foundry project endpoint:
AZURE_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_LLM_MODEL=gpt-6-astra

TINYFISH_API=
TINYFISH_JOURNEY_URL=
# Cursor MCP: https://agent.tinyfish.ai/mcp (approve/deny drafts in the console before live submit)

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

MONGO_URI=
MONGODB_URI=
MONGODB_DATABASE=cimenergy
